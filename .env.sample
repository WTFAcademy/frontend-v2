NEXT_PUBLIC_PROJECT_ID=
NEXT_PUBLIC_GITHUB_CLIENT_ID=
NEXT_PUBLIC_API_URL=https://test1.wtf.academy/api/v1
# Canonical site origin used for SEO metadata, hreflang, sitemap and robots
NEXT_PUBLIC_SITE_URL=https://www.wtf.academy

# SBT (soulbound certificate) config — BNB Chain (56 = BSC mainnet, 97 = BSC testnet)
NEXT_PUBLIC_SBT_CHAIN_ID=56
# WTFSBT1155 contract address (not yet deployed on BNB Chain)
NEXT_PUBLIC_SBT_ADDRESS=0x...
# WTFSBT1155Minter contract address (not yet deployed on BNB Chain)
NEXT_PUBLIC_SBT_MINTER_ADDRESS=0x...
# Subgraph endpoint for the SBT contracts (new BSC subgraph)
NEXT_PUBLIC_SBT_GRAPH_URL=https://api.studio.thegraph.com/query/<id>/<subgraph>/version/latest
# OpenSea collection link shown after a successful claim
NEXT_PUBLIC_SBT_OPENSEA_URL=https://opensea.io/collection/wtf-certificates-base
